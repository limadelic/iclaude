#!/bin/sh
set -e
src=$(cd "$(dirname "$0")" && pwd)
bin="$HOME/.local/bin"
launcher="$bin/claude-stable-exec"
settings="$HOME/.claude/settings.json"
mkdir -p "$HOME/.claude"
js=$(cat <<'JS'
ObjC.import('Foundation');
function read(path) {
  const err = Ref();
  const text = $.NSString.stringWithContentsOfFileEncodingError($(path), $.NSUTF8StringEncoding, err);
  if (!text) throw new Error('cannot read ' + path + ': ' + ObjC.unwrap(err[0].localizedDescription));
  return ObjC.unwrap(text);
}
function write(path, text) {
  const err = Ref();
  if (!$(text).writeToFileAtomicallyEncodingError($(path), true, $.NSUTF8StringEncoding, err))
    throw new Error('cannot write ' + path + ': ' + ObjC.unwrap(err[0].localizedDescription));
}
function isObject(v) {
  return v !== null && typeof v === 'object' && !Array.isArray(v);
}
function run(argv) {
  const settings = argv[0], launcher = argv[1], backup = argv[2];
  let original = null;
  let obj = { env: {} };
  if ($.NSFileManager.defaultManager.fileExistsAtPath($(settings))) {
    original = read(settings);
    try {
      obj = JSON.parse(original);
    } catch (e) {
      throw new Error(settings + ' is not valid JSON, nothing changed');
    }
    if (!isObject(obj)) throw new Error(settings + ' is not a JSON object, nothing changed');
    if (obj.env === undefined) obj.env = {};
    if (!isObject(obj.env)) throw new Error(settings + ' has a non-object "env", nothing changed');
  }
  obj.env.CLAUDE_CODE_PROCESS_WRAPPER = launcher;
  if (original !== null) write(backup, original);
  write(settings, JSON.stringify(obj, null, 2) + "\n");
}
JS
)
osascript -l JavaScript -e "$js" "$settings" "$bin/claude-stable-exec" "$settings.bak-claudestable"
mkdir -p "$bin"
cp "$src/claude-stable-exec" "$launcher"
chmod +x "$launcher"
echo "Restart claude and its daemon (claude daemon stop --any) to take effect."
